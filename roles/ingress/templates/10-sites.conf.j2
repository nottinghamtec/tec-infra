# {{ ansible_managed }}
{% macro tls(cert) %}
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	include /etc/nginx/snippets/ssl.conf;
	ssl_certificate /etc/letsencrypt/live/{{ cert }}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{ cert }}/privkey.pem;
{% endmacro %}
{% macro proxy(site) %}
{% if site.block_exploits | default(false) %}
	include /etc/nginx/snippets/block-exploits.conf;
{% endif %}
{% if site.basic_auth | default(false) %}
	auth_basic "Authorization required";
	auth_basic_user_file /etc/nginx/htpasswd;
{% endif %}
{% if site.extra_config | default('') | length > 0 %}
{% for line in site.extra_config.strip().splitlines() %}
	{{ line | trim }}
{% endfor %}
{% endif %}
	location / {
		set $upstream {{ site.upstream }};
		include /etc/nginx/snippets/proxy.conf;
{% if site.websocket | default(false) %}
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $http_connection;
{% endif %}
{% if site.basic_auth | default(false) %}
		proxy_set_header Authorization "";
{% endif %}
		proxy_pass $upstream;
	}
{% endmacro %}
{% for site in ingress_sites %}
{% set cert = site.cert_name | default(site.domains[0]) %}
{% set https = ingress_certs_present[cert] | default(false) %}
# {{ site.name }}
server {
	listen 80;
	listen [::]:80;
	server_name {{ site.domains | join(' ') }};
	include /etc/nginx/snippets/acme-challenge.conf;
{% if https and site.force_ssl | default(true) %}
	location / {
		return 301 https://$host$request_uri;
	}
{% else %}
{{ proxy(site) }}
{% endif %}
}
{% if https %}

server {
{{ tls(cert) }}
	server_name {{ site.domains | join(' ') }};
{{ proxy(site) }}
}
{% endif %}

{% endfor %}
{% for redirect in ingress_redirects %}
{% set cert = redirect.cert_name | default(redirect.domains[0]) %}
{% set https = ingress_certs_present[cert] | default(false) %}
{% set target = redirect.target ~ ('$request_uri' if redirect.preserve_path | default(false) else '') %}
# redirect {{ redirect.domains | join(', ') }}
server {
	listen 80;
	listen [::]:80;
{% if https %}
{{ tls(cert) }}
{% endif %}
	server_name {{ redirect.domains | join(' ') }};
	include /etc/nginx/snippets/acme-challenge.conf;
	location / {
		return {{ redirect.code | default(301) }} {{ target }};
	}
}

{% endfor %}
# Unknown hostnames
server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;
	include /etc/nginx/snippets/acme-challenge.conf;
	location / {
		return 301 {{ ingress_default_redirect }};
	}
}
server {
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;
	server_name _;
	ssl_reject_handshake on;
}
