# {{ ansible_managed }}
API_URL=http://{{ crowdsec_nginx_api_host }}:{{ crowdsec_lapi_port }}
API_KEY={{ crowdsec_bouncer_key }}
BOUNCING_ON_TYPE=all
FALLBACK_REMEDIATION=ban
MODE=stream
REQUEST_TIMEOUT=1000
EXCLUDE_LOCATION=
UPDATE_FREQUENCY=10
CACHE_EXPIRATION=1
BAN_TEMPLATE_PATH=/var/lib/crowdsec/lua/templates/ban.html
REDIRECT_LOCATION=
RET_CODE=
CAPTCHA_PROVIDER={{ 'turnstile' if crowdsec_captcha_active | bool else '' }}
SECRET_KEY={{ crowdsec_turnstile_secret_key if crowdsec_captcha_active | bool else '' }}
SITE_KEY={{ crowdsec_turnstile_site_key if crowdsec_captcha_active | bool else '' }}
CAPTCHA_TEMPLATE_PATH=/var/lib/crowdsec/lua/templates/captcha.html
CAPTCHA_EXPIRATION=3600
APPSEC_URL={{ 'http://' ~ crowdsec_nginx_api_host ~ ':' ~ crowdsec_appsec_port if crowdsec_appsec_active | bool else '' }}
APPSEC_FAILURE_ACTION={{ crowdsec_appsec_failure_action }}
APPSEC_CONNECT_TIMEOUT=100
APPSEC_SEND_TIMEOUT=100
APPSEC_PROCESS_TIMEOUT=1000
ALWAYS_SEND_TO_APPSEC=false
SSL_VERIFY=true
