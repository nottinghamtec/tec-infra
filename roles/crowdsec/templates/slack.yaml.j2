# {{ ansible_managed }}
type: slack
name: slack_default
log_level: info
group_wait: 30s
group_threshold: 10
format: |
  {% raw %}{{range . -}}{{$alert := . -}}{{range .Decisions -}}{% endraw %}:rotating_light: *{{ inventory_hostname }}*: {% raw %}{{.Type}} `{{.Value}}` for {{.Duration}} ({{$alert.Scenario}}){{"\n"}}{{end}}{{end}}{% endraw %}

webhook: {{ crowdsec_slack_webhook }}
