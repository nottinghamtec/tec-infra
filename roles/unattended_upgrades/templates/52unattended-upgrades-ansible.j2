// {{ ansible_managed }}
{% for origin in unattended_upgrades_extra_origins %}
Unattended-Upgrade::Origins-Pattern:: "{{ origin }}";
{% endfor %}
Unattended-Upgrade::Automatic-Reboot "{{ unattended_upgrades_automatic_reboot | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ unattended_upgrades_reboot_time }}";
